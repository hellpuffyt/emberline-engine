{
  "name": "emberline",
  "version": "0.1.0",
  "description": "Deterministic, rewindable 2D game engine: fixed-step ECS, input timeline with rewind/replay, AABB physics, scenes, Canvas2D renderer, asset pipeline, scripting, save files that replay.",
  "type": "module",
  "license": "MIT",
  "repository": "github:hellpuffyt/emberline-engine",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./canvas": "./dist/src/canvas.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "pack": "node tools/pack.mjs demo/assets demo/assets/manifest.json",
    "demo": "npm run build && node tools/serve.mjs",
    "headless": "npm run build && node dist/demo/headless.js",
    "lint": "tsc -p tsconfig.json --noEmit && node tools/lint.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
